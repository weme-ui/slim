{
  "name": "@weme-ui/slim",
  "version": "0.0.0",
  "description": "The slim registry of Weme UI.",
  "keywords": [
    "component",
    "composable",
    "registry",
    "unocss",
    "vue",
    "weme-ui"
  ],
  "homepage": "https://github.com/weme-ui/slim",
  "bugs": {
    "url": "https://github.com/weme-ui/slim/issues"
  },
  "license": "MIT",
  "author": "Allen Luo <luoyi@mouji.net>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weme-ui/slim.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vitepress dev docs",
    "build": "vitepress build docs",
    "preview": "vitepress preview docs",
    "play": "NODE_ENV=development bun run --cwd playground dev",
    "play:build": "NODE_ENV=development bun run --cwd playground build",
    "play:preview": "NODE_ENV=development bun run --cwd playground preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "test": "vitest run",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.5",
    "@tanstack/vue-form": "^1.33.5",
    "@vueuse/core": "^15.0.0",
    "clsx": "^2.1.1",
    "defu": "^6.1.7",
    "motion-v": "^2.11.1",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^4.0.1"
  },
  "devDependencies": {
    "@iconify-json/ri": "^1.2.10",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^26.6.6",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/server-renderer": "^3.5.45",
    "@vue/test-utils": "^2.5.1",
    "@weme-ui/unocss-preset": "^0.3.2",
    "happy-dom": "^21.0.4",
    "lint-staged": "^17.6.0",
    "magic-string": "^1.4.5",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "shiki": "^4.6.0",
    "simple-git-hooks": "^2.14.0",
    "tsrs": "^0.23.0-ts7.1.0-beta",
    "unocss": "66.10.5",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "unplugin-vue-define-options": "^3.1.4",
    "valibot": "^1.5.0",
    "vite": "^8.3.6",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vite-plugin-vue-layouts": "^0.11.0",
    "vitepress": "^2.0.0-alpha.21",
    "vitepress-plugin-llms": "^1.14.0",
    "vitest": "^5.1.0",
    "vitest-axe": "^0.1.0",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0",
    "vue-tsc": "^3.3.14"
  },
  "simple-git-hooks": {
    "pre-commit": "bun lint-staged"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts,vue}": "oxlint --fix"
  },
  "engines": {
    "bun": ">=1.3.12",
    "node": ">=22.14.0"
  },
  "packageManager": "bun@1.4.4"
}
