{
  "$schema": "https://weme-ui.github.io/weme-ui/config.schema.json",
  "paths": {
    "~": "../src",
    "component": "~/components",
    "composable": "~/composables",
    "block": "~/blocks",
    "layout": "~/layouts",
    "page": "~/pages",
    "util": "~/utils",
    "theme": "~/themes"
  },
  "theme": {
    "accentColors": ["clay", "moroccan", "puerto"],
    "neutralColors": ["gray", "iron", "covert"],
    "colorPalettes": [
      "neutral",
      "brown",
      "amber",
      "orange",
      "green",
      "blue",
      "purple",
      "pink",
      "red"
    ]
  }
}
